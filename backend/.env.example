# ==============================================================================
# PROJECT & RUNTIME CONFIGURATION
# ==============================================================================
PROJECT_NAME="Dev Template API"
ENV="development"
DEBUG=True
API_PREFIX="/api"

# Private local synthetic self-test only; both settings are required for buyer links.
SELF_TEST_MODE=False
PUBLIC_BUYER_ACCESS_POLICY=""
# Opt in with PUBLIC_BUYER_ACCESS_POLICY="self_test_link_possession" and SELF_TEST_MODE=True.

# ==============================================================================
# NEON SERVERLESS POSTGRESQL DATABASE
# ==============================================================================
# Setup Instructions:
# 1. Sign up / Log in to Neon Console: https://console.neon.tech/
# 2. Select your project -> Go to "Dashboard" or "Connection Details"
# 3. Under "Connection string", choose:
#    - "Pooled connection" (Recommended for app runtime): includes '-pooler' in the host
#    - "Direct connection" (Recommended for migrations / Alembic DDL)
# 4. Neon connection strings work out of the box with SQLAlchemy + asyncpg!
#
# Primary connection string (Pooled connection with PgBouncer):
DATABASE_URL="postgresql+asyncpg://neondb_owner:npg_your_password@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string (Recommended for schema migrations & DDL):
DIRECT_URL="postgresql+asyncpg://neondb_owner:npg_your_password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Individual connection parameters (alternative to DATABASE_URL or used by psql/neonctl)
PGHOST="ep-your-endpoint-pooler.us-east-2.aws.neon.tech"
PGDATABASE="neondb"
PGUSER="neondb_owner"
PGPASSWORD="npg_your_password"
PGPORT=5432
PGSSLMODE="require"

# ==============================================================================
# CLERK AUTHENTICATION (BACKEND)
# ==============================================================================
# Setup Instructions:
# 1. Sign up / Log in to Clerk Dashboard: https://dashboard.clerk.com/
# 2. Create or select your application
# 3. Go to "Configure" -> "API Keys":
#    - Copy "Secret Key" (sk_test_... or sk_live_...) -> CLERK_SECRET_KEY
#    - Copy "Publishable Key" (pk_test_... or pk_live_...) -> CLERK_PUBLISHABLE_KEY
# 4. (Optional) For Neon user synchronization via Webhooks:
#    - Go to "Configure" -> "Webhooks" -> "Add Endpoint"
#    - Endpoint URL: https://<your-api-domain>/api/webhooks/clerk
#    - Subscribe to: user.created, user.updated, user.deleted
#    - Copy "Signing Secret" (whsec_...) -> CLERK_WEBHOOK_SECRET
#
# Clerk Secret Key (KEEP THIS PRIVATE! Used for verifying session tokens & calling Clerk Backend API)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"

# Clerk Publishable Key (Matches frontend VITE_CLERK_PUBLISHABLE_KEY)
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# Clerk Webhook Secret (Used to securely verify Clerk webhook signatures with Svix)
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_signing_secret_here"

# Clerk Frontend API / Issuer URL (Used for local JWT decoding and token verification)
# Example: https://verb-noun-00.clerk.accounts.dev or custom domain
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"

# Optional: PEM formatted public key for offline JWT verification without network calls
CLERK_JWT_KEY=""
# Expected frontend origin (azp); set to the origin used for seller sign-in.
CLERK_AUTHORIZED_PARTY="http://localhost:5173"
# Optional audience, when the Clerk session token is configured to include aud.
CLERK_AUDIENCE=""

# ==============================================================================
# ORDER LINK ENCRYPTION
# ==============================================================================
# Stable application key used to encrypt and decrypt saved buyer portal links.
# Independent of seller authentication credentials (CLERK_SECRET_KEY).
ORDER_LINK_ENCRYPTION_KEY="your-order-link-encryption-key"

# ==============================================================================
# PAYMENT MARKER PROTECTION
# ==============================================================================
# Stable application secret used to compute HMAC payment digests and bind used-payment markers.
# Independent of seller authentication credentials (CLERK_SECRET_KEY).
PAYMENT_MARKER_SECRET="your-payment-marker-secret"

# ==============================================================================
# GOOGLE GEMINI AI API KEY
# ==============================================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# ==============================================================================
# CORS ORIGINS
# ==============================================================================
# JSON array or comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
# Courier merchant credentials require a dedicated Fernet key (urlsafe base64, 32 random bytes).
# Never reuse link, Clerk, or payment keys. Offline simulated settings require no key.
PATHAO_CREDENTIAL_ENCRYPTION_KEY=
# Server-selected buyer catalog environment; never inferred from available credentials.
# Offline fixtures require the seller's explicit offline connection and are labelled simulated.
PATHAO_LOCATION_ENVIRONMENT=offline
