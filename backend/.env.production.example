# Production scope only. Empty required secrets deliberately prevent startup.
# Populate in the backend project's encrypted environment settings, never in Git.
ENV=production
DEBUG=false
API_PREFIX=/api
SELF_TEST_MODE=false
PUBLIC_BUYER_ACCESS_POLICY=
# Enable link_possession only after the owner accepts the documented access policy.
PRODUCTION_BUYER_ACCESS_POLICY=
DATABASE_URL=
# Runtime needs no migration credential; use DIRECT_URL only in the migration environment.
DIRECT_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_MATCHING_INSTANCE
CLERK_ISSUER=https://clerk.example.com
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTY=https://shop.example.com
CLERK_AUDIENCE=
CORS_ORIGINS=["https://shop.example.com"]
ORDER_LINK_ENCRYPTION_KEY=
PAYMENT_MARKER_SECRET=
PATHAO_CREDENTIAL_ENCRYPTION_KEY=
PATHAO_LOCATION_ENVIRONMENT=offline
PATHAO_PRODUCTION_BOOKING_ENABLED=false
GEMINI_API_KEY=
REVIEW_GEMINI_ENABLED=false
