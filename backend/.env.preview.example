# Vercel supplies VERCEL_ENV=preview. Do not override that system variable.
# Safe default: offline preview, no durable writes or provider credentials.
ENV=development
DEBUG=false
API_PREFIX=/api
SELF_TEST_MODE=false
PUBLIC_BUYER_ACCESS_POLICY=
PRODUCTION_BUYER_ACCESS_POLICY=
DATABASE_URL=
DIRECT_URL=
PGHOST=
PGUSER=
PGPASSWORD=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTY=https://preview.example.com
CLERK_AUDIENCE=
CORS_ORIGINS=["https://preview.example.com"]
ORDER_LINK_ENCRYPTION_KEY=
PAYMENT_MARKER_SECRET=
PATHAO_CREDENTIAL_ENCRYPTION_KEY=
PATHAO_LOCATION_ENVIRONMENT=offline
PATHAO_PRODUCTION_BOOKING_ENABLED=false
GEMINI_API_KEY=
REVIEW_GEMINI_ENABLED=false
