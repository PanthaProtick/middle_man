{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "crons": [{"path": "/api/maintenance/retention", "schedule": "0 0 * * *"}],
  "installCommand": "uv sync --locked --no-dev",
  "functions": {
    "app/main.py": {
      "excludeFiles": "{tests/**,.env,.env.*,README.md}"
    }
  }
}
