# Dedicated Vercel Production scope for submission-demo; never inherit production secrets.
# Vercel supplies VERCEL_ENV=production. These are templates, not usable credentials.
ENV=hosted-development
DEBUG=false
API_PREFIX=/api
SELF_TEST_MODE=false
PUBLIC_BUYER_ACCESS_POLICY=
# Explicit possession-of-link buyer access; seller identity remains verified separately.
PRODUCTION_BUYER_ACCESS_POLICY=link_possession
# Copy only the verified submission-demo branch's pooled runtime-role URL, with TLS.
DATABASE_URL=
# Migration identity belongs only in the operator's migration environment.
DIRECT_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_MATCHING_INSTANCE
CLERK_ISSUER=https://REPLACE_WITH_INSTANCE.clerk.accounts.dev
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTY=https://submission-demo.example.com
CLERK_AUDIENCE=
CORS_ORIGINS=["https://submission-demo.example.com"]
# Generate independent stable demo-only secrets. Empty values prevent startup.
ORDER_LINK_ENCRYPTION_KEY=
PAYMENT_MARKER_SECRET=
PATHAO_CREDENTIAL_ENCRYPTION_KEY=
PATHAO_LOCATION_ENVIRONMENT=production
# Real external writes after seller review and explicit submit; never exercise in tests.
PATHAO_PRODUCTION_BOOKING_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
REVIEW_GEMINI_ENABLED=true
PUBLIC_REQUESTS_PER_WINDOW=600
PUBLIC_REQUEST_WINDOW_SECONDS=60
PUBLIC_REQUEST_MAX_BYTES=65536
CRON_SECRET=
