# ==============================================================================
# FASTAPI BACKEND API BASE URL
# ==============================================================================
VITE_API_BASE_URL="http://localhost:8000/api"

# ==============================================================================
# CLERK AUTHENTICATION (FRONTEND / REACT + VITE)
# ==============================================================================
# Setup Instructions:
# 1. Sign up / Log in to Clerk Dashboard: https://dashboard.clerk.com/
# 2. Select your application -> Go to "Configure" -> "API Keys"
# 3. Under "Quick Copy", select "React" or copy "Publishable Key" (pk_test_...)
#
# Clerk Publishable Key (Required by ClerkProvider in React/Vite)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# Sign-in uses the embedded Clerk flow; no separate application auth routes are required.
# Set backend CLERK_ISSUER to this instance and CLERK_AUTHORIZED_PARTY to this
# frontend's origin (http://localhost:5173 by default).
# Production seller pages require pk_live_* from the same instance as the API issuer.
# See docs/production-seller-sessions.md for exact origin and acceptance requirements.
