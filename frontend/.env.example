# ==============================================================================
# FASTAPI BACKEND API BASE URL
# ==============================================================================
VITE_API_BASE_URL="http://localhost:8000/api"

# ==============================================================================
# CLERK AUTHENTICATION (FRONTEND / REACT + VITE)
# ==============================================================================
# Setup Instructions:
# 1. Sign up / Log in to Clerk Dashboard: https://dashboard.clerk.com/
# 2. Select your application -> Go to "Configure" -> "API Keys"
# 3. Under "Quick Copy", select "React" or copy "Publishable Key" (pk_test_...)
#
# Clerk Publishable Key (Required by ClerkProvider in React/Vite)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# Frontend Authentication Routing URLs (Optional, adjust based on your routes)
VITE_CLERK_SIGN_IN_URL="/sign-in"
VITE_CLERK_SIGN_UP_URL="/sign-up"
VITE_CLERK_AFTER_SIGN_IN_URL="/"
VITE_CLERK_AFTER_SIGN_UP_URL="/"
